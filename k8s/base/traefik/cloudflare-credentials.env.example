# Cloudflare API Credentials for Traefik Let's Encrypt DNS Challenge
# Copy this file to cloudflare-credentials.env and fill in your values
#
# IMPORTANT: Never commit cloudflare-credentials.env to Git!
# The .gitignore file already excludes *.env files

# Your Cloudflare account email
email=your-email@example.com

# Cloudflare API Key (Global API Key or API Token with DNS:Edit permissions)
# Get it from: https://dash.cloudflare.com/profile/api-tokens
apiKey=your-cloudflare-api-key-here
