# Talos Linux Control Plane Configuration
# For: Proxmox VM on Beelink Mini S13 (Intel N150)
# Role: Control Plane + Worker (hybrid node)
# VM: talos-cp-1 (VM ID: 100)
# IP: 192.168.1.21
#
# This is a template. Copy to controlplane.yaml and customize:
# 1. Replace IP addresses with your network
# 2. Update domain names
# 3. Keep secrets secure (don't commit real config to Git)
#
# Host IP (Proxmox): 192.168.1.11
# VM IP (Talos): 192.168.1.21

version: v1alpha1
debug: false
persist: true

machine:
  type: controlplane

  # Installation configuration
  install:
    disk: /dev/vda  # virtio disk in Proxmox VM (not /dev/nvme0n1)
    image: ghcr.io/siderolabs/installer:v1.9.0  # Use latest stable version
    wipe: false  # Set to true for clean install (WARNING: erases disk!)
    extraKernelArgs:
      - net.ifnames=0  # Use traditional interface names (eth0, eth1)

  # Kubelet configuration
  kubelet:
    image: ghcr.io/siderolabs/kubelet:v1.29.2  # Match Kubernetes version
    extraArgs:
      rotate-server-certificates: "true"
      feature-gates: GracefulNodeShutdown=true
    clusterDNS:
      - 10.96.0.10  # CoreDNS service IP
    nodeIP:
      validSubnets:
        - 192.168.1.0/24  # Only use IPs from this subnet

  # Network configuration
  network:
    hostname: talos-cp-1

    interfaces:
      - interface: eth0  # virtio-net adapter in Proxmox
        dhcp: false
        addresses:
          - 192.168.1.21/24  # VM IP (separate from Proxmox host IP .11)
        routes:
          - network: 0.0.0.0/0
            gateway: 192.168.1.1  # Your router IP
        vip:
          ip: 192.168.1.20  # Virtual IP for Kubernetes API

    # DNS servers
    nameservers:
      - 192.168.1.5  # Pi-hole on Synology
      - 1.1.1.1     # CloudFlare DNS (fallback)

    # Extra hosts (optional)
    extraHostEntries:
      - ip: 192.168.1.5
        aliases:
          - nas.home.arpa
          - synology.home.arpa
      - ip: 192.168.1.11
        aliases:
          - pve1.home.arpa
      - ip: 192.168.1.12
        aliases:
          - pve2.home.arpa
      - ip: 192.168.1.13
        aliases:
          - pve3.home.arpa

  # Time synchronization
  time:
    disabled: false
    servers:
      - time.cloudflare.com
      - pool.ntp.org

  # Certificate SANs (Subject Alternative Names)
  certSANs:
    - 192.168.1.20  # VIP
    - 192.168.1.21  # This VM's IP
    - 127.0.0.1
    - localhost

  # Kernel modules to load
  kernel:
    modules:
      - name: br_netfilter
      - name: overlay
      - name: ip_vs
      - name: ip_vs_rr
      - name: ip_vs_wrr
      - name: ip_vs_sh

  # System disk partitions (virtio disk)
  disks:
    - device: /dev/vda
      partitions:
        - mountpoint: /var/lib/kubelet
          size: 30GB
        - mountpoint: /var/lib/containerd
          size: 50GB

  # Features
  features:
    rbac: true
    stableHostname: true
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    kubePrism:
      enabled: true
      port: 7445

  # System extensions for Proxmox VMs
  # systemExtensions:
  #   officialExtensions:
  #     - siderolabs/qemu-guest-agent  # Optional: enables Proxmox VM management features

  # Resource reservations (for control plane)
  sysctls:
    net.core.somaxconn: "65535"
    net.core.netdev_max_backlog: "5000"
    net.ipv4.tcp_max_syn_backlog: "8192"
    vm.max_map_count: "262144"

# Cluster configuration
cluster:
  id: CLUSTER_ID_PLACEHOLDER  # Will be generated by talosctl gen config
  secret: CLUSTER_SECRET_PLACEHOLDER  # Will be generated by talosctl gen config

  # Cluster name
  clusterName: my-cluster  # CHANGE THIS if desired

  # Control plane endpoint
  controlPlane:
    endpoint: https://192.168.1.20:6443  # VIP for HA

  # Cluster network configuration
  network:
    dnsDomain: cluster.local

    # Pod network CIDR (must match Cilium configuration)
    podSubnets:
      - 10.244.0.0/16

    # Service network CIDR
    serviceSubnets:
      - 10.96.0.0/12

    # CNI configuration (Cilium will be installed via Helm)
    cni:
      name: none  # We'll install Cilium manually

  # Kubernetes API server configuration
  apiServer:
    image: registry.k8s.io/kube-apiserver:v1.29.2  # Match Kubernetes version
    certSANs:
      - 192.168.1.20  # VIP
      - 192.168.1.21  # Control plane VM
      - 192.168.1.22  # Worker 2 VM
      - 192.168.1.23  # Worker 3 VM
    extraArgs:
      feature-gates: GracefulNodeShutdown=true
      oidc-issuer-url: ""  # Configure if using OIDC
    admissionControl:
      - name: PodSecurity
        configuration:
          apiVersion: pod-security.admission.config.k8s.io/v1alpha1
          kind: PodSecurityConfiguration
          defaults:
            enforce: baseline
            enforce-version: latest
            audit: restricted
            audit-version: latest
            warn: restricted
            warn-version: latest
          exemptions:
            usernames: []
            runtimeClasses: []
            namespaces:
              - kube-system
              - monitoring
              - logging
    auditPolicy:
      apiVersion: audit.k8s.io/v1
      kind: Policy
      rules:
        - level: Metadata

  # Controller manager configuration
  controllerManager:
    image: registry.k8s.io/kube-controller-manager:v1.29.2
    extraArgs:
      feature-gates: GracefulNodeShutdown=true

  # Scheduler configuration
  scheduler:
    image: registry.k8s.io/kube-scheduler:v1.29.2
    extraArgs:
      feature-gates: GracefulNodeShutdown=true

  # Discovery configuration (for node registration)
  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: false
      service:
        disabled: false

  # etcd configuration
  etcd:
    image: gcr.io/etcd-development/etcd:v3.5.11

    # Advertise on the node's IP
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381

    # Subnet for etcd members
    subnet: 192.168.1.0/24

    # etcd encryption at rest (optional but recommended)
    # advertisedSubnets:
    #   - 192.168.1.0/24

  # Cluster-wide settings
  allowSchedulingOnControlPlanes: true  # Allow workloads on control plane (hybrid mode)

  # Proxy configuration (if needed)
  # proxy:
  #   disabled: false

  # Core DNS configuration
  coreDNS:
    disabled: false
    image: registry.k8s.io/coredns/coredns:v1.11.1

  # External cloud provider (disabled for Proxmox VMs)
  externalCloudProvider:
    enabled: false

  # Admin kubeconfig settings
  adminKubeconfig:
    certLifetime: 87600h0m0s  # 10 years

  # Inline manifests (apply during bootstrap)
  inlineManifests:
    - name: namespace-security
      contents: |
        apiVersion: v1
        kind: Namespace
        metadata:
          name: security
          labels:
            pod-security.kubernetes.io/enforce: restricted
            pod-security.kubernetes.io/audit: restricted
            pod-security.kubernetes.io/warn: restricted

# Notes:
# 1. This node runs as a VM on Proxmox VE (VM ID: 100)
# 2. Disk device is /dev/vda (virtio) instead of /dev/nvme0n1 (bare metal)
# 3. Network interface is eth0 (virtio-net) bridged via vmbr0
# 4. The VIP (192.168.1.20) is managed by MetalLB after installation
# 5. Keep this file secure - it contains cluster secrets
# 6. After generation with 'talosctl gen config', customize IPs and hostnames
# 7. Never commit the actual controlplane.yaml with real secrets to Git
#
# IP Scheme:
#   Proxmox Hosts: 192.168.1.11, .12, .13
#   Talos VMs: 192.168.1.21, .22, .23
#   K8s API VIP: 192.168.1.20
#   MetalLB Pool: 192.168.1.210-220
