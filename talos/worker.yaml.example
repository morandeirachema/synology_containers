# Talos Linux Worker Node Configuration
# For: Proxmox VM on Beelink Mini S13 (Intel N150)
# Role: Worker (dedicated to running application workloads)
# VM: talos-worker-2 (VM ID: 101) or talos-worker-3 (VM ID: 102)
# IP: 192.168.1.22 (worker-2) or 192.168.1.23 (worker-3)
#
# This is a template. Copy to worker.yaml and customize:
# 1. Replace IP addresses with your network
# 2. Update hostname for each worker
# 3. Keep secrets secure (don't commit real config to Git)
#
# Create separate configs for each worker:
#   worker-2.yaml: IP 192.168.1.22, hostname talos-worker-2
#   worker-3.yaml: IP 192.168.1.23, hostname talos-worker-3

version: v1alpha1
debug: false
persist: true

machine:
  type: worker

  # Installation configuration
  install:
    disk: /dev/vda  # virtio disk in Proxmox VM (not /dev/nvme0n1)
    image: ghcr.io/siderolabs/installer:v1.9.0  # Use latest stable version
    wipe: false  # Set to true for clean install (WARNING: erases disk!)
    extraKernelArgs:
      - net.ifnames=0  # Use traditional interface names (eth0, eth1)

  # Kubelet configuration
  kubelet:
    image: ghcr.io/siderolabs/kubelet:v1.29.2  # Match Kubernetes version
    extraArgs:
      rotate-server-certificates: "true"
      feature-gates: GracefulNodeShutdown=true
    clusterDNS:
      - 10.96.0.10  # CoreDNS service IP
    nodeIP:
      validSubnets:
        - 192.168.1.0/24  # Only use IPs from this subnet

  # Network configuration
  network:
    hostname: talos-worker-2  # CHANGE THIS: talos-worker-2 or talos-worker-3

    interfaces:
      - interface: eth0  # virtio-net adapter in Proxmox
        dhcp: false
        addresses:
          - 192.168.1.22/24  # CHANGE THIS: .22 for worker-2, .23 for worker-3
        routes:
          - network: 0.0.0.0/0
            gateway: 192.168.1.1  # Your router IP

    # DNS servers
    nameservers:
      - 192.168.1.5  # Pi-hole on Synology
      - 1.1.1.1     # CloudFlare DNS (fallback)

    # Extra hosts (optional)
    extraHostEntries:
      - ip: 192.168.1.5
        aliases:
          - nas.home.arpa
          - synology.home.arpa
      - ip: 192.168.1.20
        aliases:
          - k8s-api.home.arpa
      - ip: 192.168.1.11
        aliases:
          - pve1.home.arpa
      - ip: 192.168.1.12
        aliases:
          - pve2.home.arpa
      - ip: 192.168.1.13
        aliases:
          - pve3.home.arpa

  # Time synchronization
  time:
    disabled: false
    servers:
      - time.cloudflare.com
      - pool.ntp.org

  # Certificate SANs
  certSANs: []  # Workers don't need SANs

  # Kernel modules to load
  kernel:
    modules:
      - name: br_netfilter
      - name: overlay
      - name: ip_vs
      - name: ip_vs_rr
      - name: ip_vs_wrr
      - name: ip_vs_sh

  # System disk partitions (virtio disk)
  disks:
    - device: /dev/vda
      partitions:
        - mountpoint: /var/lib/kubelet
          size: 30GB
        - mountpoint: /var/lib/containerd
          size: 50GB

  # Features
  features:
    rbac: true
    stableHostname: true
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    kubePrism:
      enabled: true
      port: 7445

  # System extensions for Proxmox VMs
  # systemExtensions:
  #   officialExtensions:
  #     - siderolabs/qemu-guest-agent  # Optional: enables Proxmox VM management features

  # System optimization for worker workloads
  sysctls:
    net.core.somaxconn: "65535"
    net.core.netdev_max_backlog: "5000"
    net.ipv4.tcp_max_syn_backlog: "8192"
    net.ipv4.ip_local_port_range: "1024 65535"
    net.ipv4.tcp_tw_reuse: "1"
    vm.max_map_count: "262144"
    fs.inotify.max_user_instances: "8192"
    fs.inotify.max_user_watches: "524288"

# Cluster configuration
cluster:
  id: CLUSTER_ID_PLACEHOLDER  # Must match control plane
  secret: CLUSTER_SECRET_PLACEHOLDER  # Must match control plane

  # Cluster name (must match control plane)
  clusterName: my-cluster  # CHANGE THIS to match control plane

  # Control plane endpoint
  controlPlane:
    endpoint: https://192.168.1.20:6443  # VIP of control plane

  # Cluster network (must match control plane)
  network:
    dnsDomain: cluster.local

    # Pod network CIDR (must match control plane)
    podSubnets:
      - 10.244.0.0/16

    # Service network CIDR (must match control plane)
    serviceSubnets:
      - 10.96.0.0/12

    # CNI (must match control plane)
    cni:
      name: none  # Cilium will be installed

  # Discovery configuration (for node registration)
  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: false
      service:
        disabled: false

  # Admin kubeconfig settings
  adminKubeconfig:
    certLifetime: 87600h0m0s  # 10 years

# Notes:
# 1. This node runs as a VM on Proxmox VE (VM ID: 101 or 102)
# 2. Disk device is /dev/vda (virtio) instead of /dev/nvme0n1 (bare metal)
# 3. Network interface is eth0 (virtio-net) bridged via vmbr0
# 4. Cluster ID and Secret MUST match the control plane
# 5. Control plane endpoint points to the VIP (192.168.1.20)
# 6. After generation with 'talosctl gen config', ensure this matches the cluster
# 7. Keep this file secure - it contains cluster secrets
# 8. Never commit the actual worker.yaml with real secrets to Git
#
# IP Scheme:
#   Proxmox Hosts: 192.168.1.11, .12, .13
#   Talos VMs: 192.168.1.21 (cp), .22 (worker-2), .23 (worker-3)
#   K8s API VIP: 192.168.1.20
#   MetalLB Pool: 192.168.1.210-220
