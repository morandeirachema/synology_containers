# Talos Linux Worker Node Configuration
# For: Beelink Mini S13 (Intel N150)
# Role: Worker (dedicated to running application workloads)
# IP: 192.168.1.202
#
# This is a template. Copy to worker.yaml and customize:
# 1. Replace IP addresses with your network
# 2. Update domain names
# 3. Keep secrets secure (don't commit real config to Git)

version: v1alpha1
debug: false
persist: true

machine:
  type: worker

  # Installation configuration
  install:
    disk: /dev/nvme0n1  # Adjust if your NVMe device is different
    image: ghcr.io/siderolabs/installer:v1.6.4  # Use latest stable version
    wipe: false  # Set to true for clean install (WARNING: erases disk!)
    extraKernelArgs:
      - net.ifnames=0  # Use traditional interface names (eth0, eth1)

  # Kubelet configuration
  kubelet:
    image: ghcr.io/siderolabs/kubelet:v1.29.2  # Match Kubernetes version
    extraArgs:
      rotate-server-certificates: "true"
      feature-gates: GracefulNodeShutdown=true
    clusterDNS:
      - 10.96.0.10  # CoreDNS service IP
    nodeIP:
      validSubnets:
        - 192.168.1.0/24  # Only use IPs from this subnet

  # Network configuration
  network:
    hostname: talos-worker-1

    interfaces:
      - interface: eth0
        dhcp: false
        addresses:
          - 192.168.1.202/24  # CHANGE THIS: Static IP for worker node
        routes:
          - network: 0.0.0.0/0
            gateway: 192.168.1.1  # CHANGE THIS: Your router IP

    # DNS servers
    nameservers:
      - 192.168.1.100  # Pi-hole on Synology
      - 1.1.1.1        # CloudFlare DNS (fallback)

    # Extra hosts (optional)
    extraHostEntries:
      - ip: 192.168.1.100
        aliases:
          - nas.home.arpa
          - synology.home.arpa
      - ip: 192.168.1.200
        aliases:
          - k8s-api.home.arpa

  # Time synchronization
  time:
    disabled: false
    servers:
      - time.cloudflare.com
      - pool.ntp.org

  # Certificate SANs
  certSANs: []  # Workers don't need SANs

  # Kernel modules to load
  kernel:
    modules:
      - name: br_netfilter
      - name: overlay
      - name: ip_vs
      - name: ip_vs_rr
      - name: ip_vs_wrr
      - name: ip_vs_sh

  # System disk partitions
  disks:
    - device: /dev/nvme0n1
      partitions:
        - mountpoint: /var/lib/kubelet
          size: 100GB
        - mountpoint: /var/lib/containerd
          size: 250GB

  # Features
  features:
    rbac: true
    stableHostname: true
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    kubePrism:
      enabled: true
      port: 7445

  # System extensions (optional)
  # systemExtensions:
  #   officialExtensions:
  #     - siderolabs/intel-ucode

  # System optimization for worker workloads
  sysctls:
    net.core.somaxconn: "65535"
    net.core.netdev_max_backlog: "5000"
    net.ipv4.tcp_max_syn_backlog: "8192"
    net.ipv4.ip_local_port_range: "1024 65535"
    net.ipv4.tcp_tw_reuse: "1"
    vm.max_map_count: "262144"
    fs.inotify.max_user_instances: "8192"
    fs.inotify.max_user_watches: "524288"

# Cluster configuration
cluster:
  id: CLUSTER_ID_PLACEHOLDER  # Must match control plane
  secret: CLUSTER_SECRET_PLACEHOLDER  # Must match control plane

  # Cluster name (must match control plane)
  clusterName: my-cluster  # CHANGE THIS to match control plane

  # Control plane endpoint
  controlPlane:
    endpoint: https://192.168.1.200:6443  # VIP of control plane

  # Cluster network (must match control plane)
  network:
    dnsDomain: cluster.local

    # Pod network CIDR (must match control plane)
    podSubnets:
      - 10.244.0.0/16

    # Service network CIDR (must match control plane)
    serviceSubnets:
      - 10.96.0.0/12

    # CNI (must match control plane)
    cni:
      name: none  # Cilium will be installed

  # Discovery configuration (for node registration)
  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: false
      service:
        disabled: false

  # Admin kubeconfig settings
  adminKubeconfig:
    certLifetime: 87600h0m0s  # 10 years

# Notes:
# 1. This is a dedicated worker node (no control plane components)
# 2. Optimized for running application workloads
# 3. Cluster ID and Secret MUST match the control plane
# 4. Control plane endpoint points to the VIP (192.168.1.200)
# 5. After generation with 'talosctl gen config', ensure this matches the cluster
# 6. Keep this file secure - it contains cluster secrets
# 7. Never commit the actual worker.yaml with real secrets to Git
