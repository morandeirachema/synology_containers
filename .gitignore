# Environment variables
.env
*.env
!.env.example

# Data directories
data/
logs/
backups/

# Configuration with secrets
config/**/secrets.yml
config/**/*.key
config/**/*.pem
config/**/*.crt

# Specific service data
config/traefik/acme.json
config/authelia/db.sqlite3
config/authelia/notification.txt
config/wireguard/*.conf
config/wireguard/peer_*

# Database files
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.swp
*~

# OS files
.DS_Store
Thumbs.db
.directory

# IDE files
.vscode/
.idea/
*.iml

# Docker volumes (if any local volume data)
volumes/

# Backup files
*.backup
*.bak
*.old

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Terraform outputs (sensitive)
infrastructure/terraform/*/outputs/

# Ansible
*.retry
infrastructure/ansible/inventory/hosts.yml
!infrastructure/ansible/inventory/hosts.yml.example

# Talos configs (sensitive)
talos/controlplane.yaml
talos/worker*.yaml
talos/talosconfig
talos/kubeconfig
!talos/*.example

# Kubernetes secrets (env files used by kustomize)
k8s/**/*.env
!k8s/**/*.env.example
