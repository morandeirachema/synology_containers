# Synology DS 224+ Container Stack - Environment Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Keep .env file secure and never commit it to version control

##################################################
# GLOBAL SETTINGS
##################################################

# Timezone - Use format from: timedatectl list-timezones
TZ=America/New_York

# Your domain name (for external access via Traefik)
DOMAIN=yourdomain.com

# Your NAS local IP address
NAS_IP=192.168.1.100

##################################################
# CLOUDFLARE (for Traefik SSL certificates)
##################################################

# CloudFlare API credentials for DNS challenge
CF_API_EMAIL=your-email@example.com
CF_DNS_API_TOKEN=your-cloudflare-api-token

##################################################
# AUTHELIA - Authentication & 2FA
##################################################

# Generate these with: openssl rand -hex 32
AUTHELIA_JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
AUTHELIA_SESSION_SECRET=changeme-generate-with-openssl-rand-hex-32
AUTHELIA_STORAGE_ENCRYPTION_KEY=changeme-generate-with-openssl-rand-hex-32

##################################################
# WIREGUARD VPN
##################################################

# Your public IP or dynamic DNS hostname
WIREGUARD_SERVERURL=vpn.yourdomain.com

# Number of client configurations to generate (comma-separated names)
WIREGUARD_PEERS=laptop,phone,tablet

##################################################
# VAULTWARDEN - Password Manager
##################################################

# Generate with: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=changeme-generate-with-openssl-rand-base64-48

# SMTP settings for email notifications (optional but recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=noreply@yourdomain.com
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

##################################################
# NEXTCLOUD - File Sync & Productivity
##################################################

# Admin credentials
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme-strong-password

# Database passwords
NEXTCLOUD_DB_PASSWORD=changeme-strong-db-password
NEXTCLOUD_DB_ROOT_PASSWORD=changeme-strong-root-password

# Data storage path (create this directory on your NAS)
NEXTCLOUD_DATA_PATH=/volume1/nextcloud-data

##################################################
# IMMICH - Photo Management
##################################################

# Database password
IMMICH_DB_PASSWORD=changeme-strong-db-password

# Upload location for photos (create this directory on your NAS)
IMMICH_UPLOAD_LOCATION=/volume1/immich-library

##################################################
# PAPERLESS-NGX - Document Management
##################################################

# Admin credentials
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=changeme-strong-password

# Database password
PAPERLESS_DB_PASSWORD=changeme-strong-db-password

# Generate with: openssl rand -base64 32
PAPERLESS_SECRET_KEY=changeme-generate-with-openssl-rand-base64-32

# Directory paths (create these on your NAS)
PAPERLESS_CONSUME_DIR=/volume1/paperless/consume
PAPERLESS_EXPORT_DIR=/volume1/paperless/export

##################################################
# GRAFANA - Metrics Visualization
##################################################

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-strong-password

##################################################
# DIUN - Docker Update Notifications (Optional)
##################################################

# Optional: Configure Gotify for notifications
# Leave empty to disable notifications
GOTIFY_ENDPOINT=
GOTIFY_TOKEN=

##################################################
# SECURITY NOTES
##################################################
#
# 1. Replace ALL "changeme" values before deployment
# 2. Use strong, unique passwords for each service
# 3. Store a backup of this file in a secure location
# 4. Use a password manager (like Vaultwarden!) to generate secure passwords
# 5. Never commit the .env file to version control
# 6. Recommended: Use different admin usernames (not just "admin")
#
# Password generation examples:
# - openssl rand -hex 32     (64 character hex)
# - openssl rand -base64 32  (44 character base64)
# - openssl rand -base64 48  (64 character base64)
#
##################################################
